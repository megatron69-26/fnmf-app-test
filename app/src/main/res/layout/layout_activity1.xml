<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#131722"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_login_title"
        android:textColor="#00F0FF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_login_subtitle"
        android:textColor="#787B86"
        android:textSize="13sp"
        android:layout_marginBottom="24dp"/>

    <!-- 1. EMAIL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_email_label"
        android:textColor="#787B86"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/auth_email_hint"
        android:textColorHint="#4E5467"
        android:textColor="#FFFFFF"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:background="#1E222D"
        android:padding="10dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <!-- 2. PASSWORD -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_password_label"
        android:textColor="#787B86"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/auth_password_hint"
        android:textColorHint="#4E5467"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:background="#1E222D"
        android:padding="10dp"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"/>

    <!-- 3. NÚT ĐĂNG NHẬP -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/auth_btn_login"
        android:backgroundTint="#2962FF"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <!-- 4. NÚT ĐĂNG KÝ MỚI -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/auth_btn_register"
        android:backgroundTint="#089981"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- 5. CẤU HÌNH SERVER TEST ĐỘC LẬP (NOTE10+) -->
    <Button
        android:id="@+id/btnTestServerConfig"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="⚙️ Cấu hình Server Test"
        android:backgroundTint="#4E5467"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvCurrentServerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server: Chưa cấu hình"
        android:textColor="#FFA726"
        android:textSize="11sp"
        android:gravity="center"/>
</LinearLayout>
